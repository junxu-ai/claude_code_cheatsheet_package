{
  "permissions": {
    "allow": [
      "Bash(pnpm test)",
      "Bash(pnpm tsc --noEmit)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./secrets/**)",
      "Bash(git push --force *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/block_protected.py"
          }
        ]
      }
    ]
  }
}
